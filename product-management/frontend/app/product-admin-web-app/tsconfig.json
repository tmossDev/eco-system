/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@foundation/*": ["./../../../../shared-components/frontend/package/design-system/foundation/*/src/public-api.ts"],
      "@primitive/*": ["./../../../../shared-components/frontend/package/design-system/primitive/*/src/public-api.ts"],
      "@shared/*": ["./../../../../shared-components/frontend/package/design-system/shared/*/src/public-api.ts"],
      "@eco/auth-features": ["./../../../../shared-components/frontend/package/auth-features/src/public-api.ts"],
      "@eco/admin-features": ["./../../../../shared-components/frontend/package/admin-features/src/public-api.ts"],
      "@eco/admin-features/order": ["./../../../../shared-components/frontend/package/admin-features/src/lib/order/pages/orders/order.routes.ts"],
      "@eco/admin-features/product": ["./../../../../shared-components/frontend/package/admin-features/src/lib/product/pages/products/product.routes.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./../../../../shared-components/frontend/package/design-system/tsconfig.json"
    },
    {
      "path": "./../../../../shared-components/frontend/package/admin-features/tsconfig.lib.json"
    },
    {
      "path": "./../../../../shared-components/frontend/package/auth-features/tsconfig.lib.json"
    }
  ]
}
