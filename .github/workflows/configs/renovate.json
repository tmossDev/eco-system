{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "branchPrefix": "feature/",
  "branchPrefixOld": "renovate/",
  "hashedBranchLength": 18,
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "npm",
    "gomod",
    "dockerfile",
    "github-actions",
    "helmv3"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.angular/cache/**",
    "**/dist/**"
  ],
  "rangeStrategy": "bump",
  "postUpdateOptions": [
    "gomodTidy",
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "description": "Keep all dependency updates in one pull request",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "separateMajorMinor": false
    },
    {
      "description": "Iris 12 requires the pre-0.2 golog API",
      "matchPackageNames": [
        "github.com/kataras/golog"
      ],
      "allowedVersions": "<0.2.0"
    },
    {
      "description": "Iris 12 requires the pre-0.0.14 pio rich-text API",
      "matchPackageNames": [
        "github.com/kataras/pio"
      ],
      "allowedVersions": "<0.0.14"
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "all dependencies",
    "groupSlug": "all",
    "branchTopic": "all",
    "commitMessageSuffix": ""
  },
  "separateMajorMinor": false
}
