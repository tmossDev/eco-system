{
  "name": "design-system",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "corepack pnpm build:tokens && corepack pnpm build:button && corepack pnpm build:icon && corepack pnpm build:form && corepack pnpm build:navigation-bar && corepack pnpm build:login-form",
    "build:tokens": "corepack pnpm --filter @foundation/tokens build",
    "build:button": "ng build button",
    "build:icon": "ng build icon",
    "build:navigation-bar": "ng build navigation-bar",
    "build:login-form": "corepack pnpm build:tokens && corepack pnpm build:button && corepack pnpm build:form && ng build login-form",
    "build:form": "ng build form",
    "watch:tokens": "corepack pnpm --filter @foundation/tokens watch",
    "watch:button": "ng build button --watch --configuration development",
    "watch:icon": "ng build icon --watch --configuration development",
    "watch:navigation-bar": "ng build navigation-bar --watch --configuration development",
    "watch:login-form": "ng build login-form --watch --configuration development",
    "watch:form": "ng build form --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@storybook/angular": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "jsdom": "catalog:",
    "ng-packagr": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
