{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": "193c01d7-5762-4b24-a53b-146e58325b64"
  },
  "newProjectRoot": "primitive",
  "projects": {
    "button": {
      "projectType": "library",
      "root": "primitive/button",
      "sourceRoot": "primitive/button/src",
      "prefix": "primitive",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "primitive/button/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "primitive/button/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "primitive/button/tsconfig.spec.json"
          }
        }
      }
    },
